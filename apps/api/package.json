{
  "name": "api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "db:studio": "dotenv -e .env -- prisma studio",
    "db:push": "dotenv -e .env -- prisma db push",
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config ./jest.config.mjs",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --config ./jest.config.mjs --watch",
    "prisma:generate": "dotenv -e .env -- prisma generate",
    "prisma:migrate:dev": "dotenv -e .env -- prisma migrate dev",
    "prisma:studio": "dotenv -e .env -- prisma studio",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@nestjs/common": "11.1.21",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "11.1.21",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "11.1.21",
    "@nestjs/swagger": "^11",
    "@nestjs/throttler": "^6",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@repo/contracts": "workspace:*",
    "@scalar/nestjs-api-reference": "^1.1.18",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "express": "^5.2.1",
    "nodemailer": "^8.0.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "catalog:",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.21",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.21",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "catalog:",
    "@types/supertest": "catalog:",
    "dotenv-cli": "^11.0.0",
    "jest": "catalog:",
    "prisma": "catalog:",
    "supertest": "catalog:",
    "ts-jest": "catalog:",
    "typescript": "catalog:"
  }
}
