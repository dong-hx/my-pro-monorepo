# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/my_pro_db?schema=public"

# JWT
JWT_SECRET="change-me-to-a-random-string-at-least-16-chars"
JWT_EXPIRES_IN="15m"

# CORS (comma-separated origins)
CORS_ORIGIN="http://localhost:5173"

# SMTP (optional, falls back to console log in development)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your-password
# SMTP_FROM="My App <noreply@example.com>"

# Server
PORT=3001
